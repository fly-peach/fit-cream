# ===========================================
# FitCream 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ===========================================

# ---------- 应用配置 ----------
APP_NAME=FitCream
DEBUG=true
API_PREFIX=/api
# 是否开放 Swagger UI / OpenAPI（默认关闭；生产环境保持 false）
API_DOCS_ENABLED=false

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://fitcream:fitcream@localhost:5432/fitcream
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---------- JWT 认证 ----------
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- httpOnly Cookie 认证 ----------
# token 写入 httpOnly Cookie（SameSite=Lax），前端不接触 token 明文。
# 生产走 HTTPS 时必须设为 true，否则浏览器不会携带 Secure Cookie。
COOKIE_SECURE=false

# ---------- 阿里云 SMS（号码认证 - 短信认证） ----------
# 运营商管控下自定义签名易下发失败，需用号码认证控制台赠送的签名/模板，
# 二者必须搭配使用，走 dypnsapi SendSmsVerifyCode 接口。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SMS_SIGN_NAME=
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=

# ---------- 阿里云 OSS 对象存储 ----------
# 留空时聊天图片回退为 base64 data URL（开发模式）
# AccessKey 与上方 SMS 共用 ALIBABA_CLOUD_ACCESS_KEY_ID / SECRET
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
# 签名 URL 有效期（秒），默认 7 天（避免 URL 泄露后图片被长期访问）
OSS_SIGN_URL_EXPIRES=604800

# ---------- 安全策略 ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
VERIFICATION_CODE_LENGTH=4
VERIFICATION_CODE_EXPIRE_MINUTES=5
VERIFICATION_CODE_COOLDOWN=60
VERIFICATION_CODE_MAX_PER_HOUR=5

# ---------- 种子管理员（首次启动自动创建） ----------
SEED_ADMIN_PHONE=your-phone-number
SEED_ADMIN_PASSWORD=your-password-here

# ---------- DashScope (通义千问) ----------
DASHSCOPE_API_KEY=sk-your-api-key
DASHSCOPE_MODEL=qwen3.5-flash
DASHSCOPE_VISION_MODEL=qwen3-vl-flash
DASHSCOPE_TEMPERATURE=1.2
DASHSCOPE_ENABLE_THINKING=true

# ---------- CORS（JSON 数组格式） ----------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------- 限流 ----------
AGENT_RATE_LIMIT=10

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FORMAT=text
# 日志输出目录（相对于项目根目录），留空则仅输出到控制台
LOG_DIR=logs
# 是否记录每次 HTTP 请求日志（access log）
ACCESS_LOG_ENABLED=true
# 日志文件保留天数
LOG_RETENTION_DAYS=30

# ---------- 前端环境变量 (Vite) ----------
# 开发环境使用 Vite proxy 时可不设置（默认走 /api 代理）
VITE_API_URL=http://localhost:8000/api
