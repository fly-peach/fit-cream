# ===========================================
# FitCream 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ===========================================

# ---------- 应用配置 ----------
APP_NAME=FitCream
DEBUG=true
API_PREFIX=/api
# 是否开放 Swagger UI / OpenAPI（默认关闭；生产环境保持 false）
API_DOCS_ENABLED=false
# Agent 时间上下文与打卡/饮食默认日期的时区（默认国内用户 UTC+8）
APP_TZ=Asia/Shanghai

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://fitcream:fitcream@localhost:5432/fitcream
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---------- JWT 认证 ----------
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- httpOnly Cookie 认证 ----------
# token 写入 httpOnly Cookie（SameSite=Lax），前端不接触 token 明文。
# 生产走 HTTPS 时必须设为 true：COOKIE_SECURE=true 时 SameSite=None + Secure，
# Capacitor App（本地 WebView，origin=https://localhost）跨站请求才会携带 Cookie。
COOKIE_SECURE=false

# ---------- 阿里云 SMS（号码认证 - 短信认证） ----------
# 运营商管控下自定义签名易下发失败，需用号码认证控制台赠送的签名/模板，
# 二者必须搭配使用，走 dypnsapi SendSmsVerifyCode 接口。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SMS_SIGN_NAME=
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=

# ---------- 阿里云 OSS 对象存储 ----------
# 留空时聊天图片回退为 base64 data URL（开发模式）
# AccessKey 与上方 SMS 共用 ALIBABA_CLOUD_ACCESS_KEY_ID / SECRET
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
# 签名 URL 有效期（秒），默认 15 天（兼顾跨天对话图片可见与泄露风险）
OSS_SIGN_URL_EXPIRES=1296000

# ---------- 安全策略 ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
VERIFICATION_CODE_LENGTH=4
VERIFICATION_CODE_EXPIRE_MINUTES=5
VERIFICATION_CODE_COOLDOWN=60
VERIFICATION_CODE_MAX_PER_HOUR=5

# ---------- 种子管理员（首次启动自动创建） ----------
SEED_ADMIN_PHONE=your-phone-number
SEED_ADMIN_PASSWORD=your-password-here

# ---------- DashScope (通义千问) ----------
DASHSCOPE_API_KEY=sk-your-api-key
# 默认统一为 qwen3.7-plus（多模态，兼容文本+图片），不再区分文本/视觉模型切换
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_VISION_MODEL=qwen3-vl-flash
DASHSCOPE_TEMPERATURE=0.7
DASHSCOPE_ENABLE_THINKING=true

# ---------- 知识库语义检索（rerank） ----------
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_TOP_N=20
# 知识库语义向量整体开关（关闭后检索/摄入退化为纯全文）
KB_EMBEDDING_ENABLED=true
# 动作库混合检索 rerank 开关（关闭后 exercise hybrid_search 退化为纯向量序）
EXERCISE_RERANK_ENABLED=true

# ---------- DeepSeek 官方 API（视觉模型，多模态 / 用户自备 Key BYOK） ----------
# deepseek-v4-flash-vision-exp 仅在 DeepSeek 官方端点提供（DashScope 未托管，
# 且 DashScope 上的 deepseek 文本模型收到图片会静默丢弃）。
# 需要 pip install langchain-deepseek。
# DEEPSEEK_API_KEY 为我方兜底环境 key；用户自备 key（仅存前端 localStorage，15 天
# 过期）优先于它，且不会上传到后端存储。
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TEMPERATURE=0.7

# ---------- CORS（JSON 数组格式） ----------
# https://localhost / http://localhost 为 Capacitor App（本地 WebView）origin，
# 生产必须包含，否则 App 内请求被 CORS 拦截报「网络错误」。
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","https://localhost","http://localhost","https://www.ice-cream.top"]

# ---------- 记忆容量上限 ----------
# 每用户各类记忆的上限条数，超过上限时按淘汰策略删除多余记录
# 情景记忆按 重要性升序→时间升序 删除；程序记忆按 最久未使用 删除
MEMORY_EPISODIC_MAX=200
MEMORY_PROCEDURAL_MAX=50
# 语义记忆每分类（偏好/事实/规则）上限，超出按 低置信度→最旧 删除（status 不裁剪）
MEMORY_SEMANTIC_MAX=15

# ---------- 限流 ----------
AGENT_RATE_LIMIT=10

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FORMAT=text
# 日志输出目录（相对于项目根目录），留空则仅输出到控制台
LOG_DIR=logs
# 是否记录每次 HTTP 请求日志（access log）
ACCESS_LOG_ENABLED=true
# 日志文件保留天数
LOG_RETENTION_DAYS=30
# 慢请求阈值（毫秒）：超过则在 access log 中以 WARNING 高亮并标记 slow
SLOW_REQUEST_MS=3000

# ---------- 前端环境变量 (Vite) ----------
# 开发环境使用 Vite proxy 时可不设置（默认走 /api 代理）
VITE_API_URL=http://localhost:8000/api
# 首页底部「联系相关人员」展示信息（留空则对应条目不显示）
VITE_CONTACT_PHONE=
VITE_CONTACT_WECHAT=
